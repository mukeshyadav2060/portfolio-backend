# ── Database ────────────────────────────────────────────────────────────────
# Local SQLite file by default. For production use Turso (libSQL):
#   DATABASE_URL=libsql://<db>-<org>.turso.io
#   DATABASE_AUTH_TOKEN=<token>
DATABASE_URL=file:./data/portfolio.db
DATABASE_AUTH_TOKEN=

# ── Admin ───────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
# 32+ random characters: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=dev-only-secret-change-me-dev-only-secret
# Optional bearer token for scripts / CI calling the admin API
ADMIN_API_TOKEN=

# ── Frontend integration ────────────────────────────────────────────────────
# Origins allowed to call the API from a browser (comma separated)
CORS_ORIGINS=http://localhost:3000
# Where to send on-demand revalidation webhooks after admin edits
FRONTEND_URL=http://localhost:3000
# Must match REVALIDATE_SECRET in the frontend
REVALIDATE_SECRET=dev-revalidate-secret

# ── Files ───────────────────────────────────────────────────────────────────
PUBLIC_URL=http://localhost:4000
UPLOAD_DIR=./data/uploads

# ── Optional integrations ───────────────────────────────────────────────────
# Enables the contribution calendar. Use a *classic* token with `repo` + `read:user` to
# include private and organisation contributions (a fine-grained token only covers one
# account or org, so private work elsewhere is left out). `read:user` alone = public only.
GITHUB_TOKEN=
# Email notifications for new contact messages
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=
