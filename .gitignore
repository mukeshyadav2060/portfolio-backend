# ── Dependencies ─────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Next.js build output ─────────────────────
/.next/
/out/
/build

# ── Environment (never commit secrets) ───────
.env
.env.*
!.env.example

# ── Vercel ───────────────────────────────────
.vercel

# ── TypeScript ───────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Testing / tooling caches ─────────────────
/coverage
.eslintcache
.turbo

# ── Logs ─────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── OS / editor ──────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# ── Certificates ─────────────────────────────
*.pem

# ── Local database and uploaded files ────────
/data/
*.db
*.db-journal
*.db-wal
*.db-shm
